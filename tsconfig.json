{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "Node16",
        "moduleResolution": "Node16",
        "types": ["node", "jest"],
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "sourceMap": false,
        "declarationMap": false
    },
    "include": ["src/**/*"],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
